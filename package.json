{
  "name": "minijam-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "start:en": "docusaurus start --locale en",
    "start:zh": "docusaurus start --locale zh-CN",
    "build": "docusaurus build",
    "build:en": "docusaurus build --locale en",
    "build:zh": "docusaurus build --locale zh-CN",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "write-translations:zh": "docusaurus write-translations --locale zh-CN",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.2"
  }
}
